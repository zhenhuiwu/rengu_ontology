# 复制为 .env.local 使用（.env.local 不入库）。说明见 docs/backend/integration.md
# real（默认）| mock（仅显式演示）
VITE_API_MODE=real
# 可选：按负责模块切真接口，逗号分隔。开关键（不是接口前缀）：
#   static, dynamic, action, versioning（这四个都在 /api/ontology/v1 下，各自独立）, qa, biz, admin, data, integration（/api/data/v1）
#   动作类型 / 事件类型 / 事件 / 投递都归 action，没有单独的 event 键；/action-runs 归 dynamic；外部系统 /ext-systems 归 integration
# 照字面执行：
#   - 不设或留空：mock 模式 = 全 mock；real 模式 = 全部走真接口
#   - 设了值：两种模式下都只切列出的键；全是未知键 = 一个都不切（控制台 warn 未知键）
# 例：只切发布记录 → VITE_API_REAL_MODULES=versioning
VITE_API_REAL_MODULES=
# 开发服务器 /api 代理目标（后台骨架地址）
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
