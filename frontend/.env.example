# 复制为 .env.local 使用（.env.local 不入库）。说明见 docs/backend/integration.md
# mock（默认）| real
VITE_API_MODE=mock
# 可选：按负责模块切真接口，逗号分隔。开关键（不是接口前缀）：
#   static, dynamic, action, versioning（这四个都在 /api/ontology/v1 下，各自独立）, qa, biz, admin, data, integration
# 例：只切发布记录 → VITE_API_REAL_MODULES=versioning
VITE_API_REAL_MODULES=
# 开发服务器 /api 代理目标（后台骨架地址）
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
