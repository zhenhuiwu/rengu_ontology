[
  {
    "id": "R-007",
    "name": "商品毛利率越线",
    "version": 3,
    "status": "变更中",
    "owner": "刘婷",
    "core": true,
    "objKind": "product",
    "level": "高",
    "output": "告警",
    "weekly": 54,
    "desc": "商品毛利率从 ≥ 18% 跌破 18% 时产生告警，只在越线那一次触发。",
    "conds": [
      {
        "metric": "gross_margin",
        "metricVer": 2,
        "field": "毛利率",
        "op": "<",
        "value": "18.00%"
      },
      {
        "metric": "gross_margin",
        "metricVer": 2,
        "field": "上次计算的毛利率",
        "op": "≥",
        "value": "18.00%"
      }
    ],
    "logic": "且",
    "expr": "gross_margin@v2(sku, store, day) < 0.18 AND prev(gross_margin@v2) >= 0.18",
    "dedupe": "规则 + 商品 + 门店 + 日期",
    "cooldown": "7 天",
    "trigger": {
      "kind": "定时",
      "cron": "0 8 * * *",
      "text": "每天 08:00（数据截至前一日 23:00）"
    },
    "actionTypeId": "start_price_approval",
    "autoStage": {
      "enabled": true,
      "actionTypeId": "start_price_approval",
      "confirmer": "品类经理 王敏",
      "mapping": [
        {
          "param": "商品",
          "from": "告警.对象"
        },
        {
          "param": "原因",
          "from": "规则.命中说明"
        },
        {
          "param": "备注",
          "from": "规则.建议值（毛利率回到 18%）"
        },
        {
          "param": "关联告警",
          "from": "告警.ID"
        }
      ]
    }
  },
  {
    "id": "R-012",
    "name": "可用库存低于安全线",
    "version": 2,
    "status": "已发布",
    "owner": "周晓峰",
    "core": true,
    "objKind": "product",
    "level": "高",
    "output": "告警",
    "weekly": 386,
    "desc": "收到库存变动事件后，可用库存低于门店安全库存时产生告警。",
    "conds": [
      {
        "field": "可用库存",
        "op": "<",
        "value": "安全库存"
      },
      {
        "field": "商品状态",
        "op": "=",
        "value": "在售"
      }
    ],
    "logic": "且",
    "expr": "event.available < product.safetyStock(store) AND product.status = \"在售\"",
    "dedupe": "规则 + 商品 + 门店",
    "cooldown": "24 小时",
    "trigger": {
      "kind": "事件",
      "eventId": "inventory_changed",
      "text": "订阅“库存变动”（InventoryChanged）",
      "filter": "changeType ∈ {出库, 调拨出, 盘亏}"
    },
    "actionTypeId": "request_replenish",
    "autoStage": {
      "enabled": true,
      "actionTypeId": "request_replenish",
      "confirmer": "供应链计划员 周晓峰",
      "mapping": [
        {
          "param": "商品",
          "from": "事件.SKU"
        },
        {
          "param": "门店",
          "from": "事件.门店"
        },
        {
          "param": "补货数量",
          "from": "安全库存 × 1.5 − 可用库存"
        },
        {
          "param": "补货方式",
          "from": "固定值：仓库调拨"
        },
        {
          "param": "关联告警",
          "from": "告警.ID"
        }
      ]
    }
  },
