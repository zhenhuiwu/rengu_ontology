      "confirmer": "订单运营组 孙浩然",
      "mapping": [
        {
          "param": "订单",
          "from": "事件.订单号"
        },
        {
          "param": "目标状态",
          "from": "生命周期上一个合法状态"
        },
        {
          "param": "修正原因",
          "from": "固定值：系统同步乱序"
        },
        {
          "param": "关联告警",
          "from": "告警.ID"
        }
      ]
    }
  },
