# 复制为 .env 后按需修改（.env 不入库）
RENGU_ENV=dev
RENGU_DATABASE_URL=postgresql+asyncpg://rengu:rengu@127.0.0.1:5440/rengu
RENGU_LOG_LEVEL=INFO
# 问数及自动建模共用的模型凭据；环境变量优先，本地 .env 也可配置。此处不得填写真实密钥。
# DASHSCOPE_API_KEY=
# QA_LLM_MODEL=qwen-flash
# QA_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AUTO_ONTOLOGY_LLM_MODEL=qwen-flash
# AUTO_ONTOLOGY_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 内部事件接收：使用强随机凭证，经 Authorization: Bearer 发送；未配置时端点503，禁止提交真实值。
# RENGU_INTERNAL_EVENT_TOKEN=
# 旧凭证只授权本体1；其他本体需显式X-Ontology-Id及其独立token映射（实际值仅放ignored .env）。
# RENGU_INTERNAL_EVENT_TOKENS={"2":"replace-in-local-env"}
# 外部查询/探测只有经授权后才启用；默认不发网络请求。真实JSON与token只放ignored .env。
# RENGU_INTEGRATION_REAL_CONNECT=false
# Explicitly authorize only trusted datasource hostnames/IPs for real connection tests.
# RENGU_DS_REAL_CONNECT=1
# RENGU_DS_ALLOWED_HOSTS=db.example.internal
# RENGU_DS_SECRET_KEY=<stable-fernet-key>
# Read-only external probes: trusted CIDRs and ports only; business actions require separate authorization.
# RENGU_INTEGRATION_PROBE_NETWORKS=[{"cidr":"192.0.2.0/24","ports":[8080]}]
# 可选：出站动作/事件的私有 CA PEM 文件；保留证书及主机名验证，不读取代理环境变量。
# RENGU_INTEGRATION_CA_FILE=C:/local-certs/receiver-ca.pem
# 配置键使用<ontology_id>/<system_code>；不带本体前缀的旧键只适用于本体1。
# RENGU_INTEGRATION_ADAPTERS={"EXT-ERP":{"queryPath":"/ontology/idempotency","probePath":"/health","token":"replace-in-local-env"}}
# 仅 dev/test：精确指定即将创建的本机演示系统；同时配置同一系统的 submit/query 适配器路径。
# RENGU_INTEGRATION_LOCAL_DEMO={"ontologyId":1,"systemCode":"EXT-N01","origin":"https://127.0.0.1:8443","submitPath":"/submit","queryPath":"/query"}
# 关闭时先停止或排空所有执行器；已发出的请求不能撤回。演示系统不支持 probe/effect。
# 外部系统 auth 选“无需授权”时不会发送 token；签名密钥 signing_secret 独立配置，切回其他认证方式会重新使用已有 token。
# 演示身份：sys_user.code（U010001 = 王敏，演示管理员），不是姓名
RENGU_DEV_USER=U010001
# dev/prod 不设置时使用真实时间；test 默认固定时间，seed 重放需显式配置。仅复现特定场景时显式冻结：
# RENGU_FIXED_NOW=2026-10-25T15:42:00+08:00
# RENGU_AUTO_ONTOLOGY_URL=http://auto-ontology:8000

# 订阅投递路由键使用<ontology_id>/<event_type_code>/<subscriber_name>；旧无前缀键仅本体1可用。
# RENGU_EVENT_DELIVERY_ROUTES={}
